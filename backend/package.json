{
  "name": "helm-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/seed/run-seed.ts",
    "verify:agents": "node scripts/verify-agents.mjs",
    "probe:pdf": "tsx scripts/probe-pdf.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.65.0",
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "10.1.0",
    "@fastify/helmet": "13.0.1",
    "@fastify/rate-limit": "10.3.0",
    "@types/pg": "^8.11.10",
    "dotenv": "16.4.7",
    "fastify": "5.4.0",
    "neo4j-driver": "5.28.1",
    "pg": "^8.13.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "pino-pretty": "^13.0.0",
    "tsx": "4.19.2",
    "typescript": "5.7.3"
  },
  "allowScripts": {
    "esbuild@0.23.1": true
  }
}
