# Copy to .env and fill in what you have. The service boots with every value
# blank: each integration falls back to something demonstrable, and
# /api/health reports which one is actually running.

APP_ENV=development
APP_NAME=HELM
LOG_LEVEL=info
HOST=0.0.0.0

BACKEND_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# --- Session / crypto -------------------------------------------------------
# Generate both. Rotating JWT_SECRET signs every existing session out;
# rotating TOKEN_ENCRYPTION_KEY makes stored provider tokens unreadable.
#   openssl rand -base64 48   → JWT_SECRET
#   openssl rand -base64 32   → TOKEN_ENCRYPTION_KEY (must decode to 32 bytes)
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=
SESSION_COOKIE_NAME=helm_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# --- Decision graph ---------------------------------------------------------
# Neon or any Postgres. Leave blank to fall back to Neo4j, and blank again to
# fall back to the in-process store.
DATABASE_URL=
NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Identity switches ------------------------------------------------------
# AUTH_ENABLED=false  → no sign-in step; every request is the sample owner.
# RBAC_ENABLED=false  → every permission granted regardless of role.
# Neither affects the database.
AUTH_ENABLED=true
RBAC_ENABLED=true

# --- Google sign-in ---------------------------------------------------------
# One Google Cloud OAuth client covers both grants. Register both redirect URIs
# on it exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Google Ads (separate consent, same client is fine) ---------------------
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=http://localhost:8000/api/integrations/google-ads/callback
GOOGLE_ADS_API_VERSION=v22
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Runs the real consent flow but reads the sample portfolio. The correct
# setting while the developer token is still on basic access.
GOOGLE_ADS_MOCK=true

# --- Meta Ads ---------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=v21.0
META_REDIRECT_URI=http://localhost:8000/api/integrations/meta-ads/callback
META_CONFIG_ID=

# --- Agent reasoning --------------------------------------------------------
# Without a key the four agents run their deterministic sample reasoning and
# the product reports `scripted` rather than pretending a model answered.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_REVIEW_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=16000

# --- Image studio -----------------------------------------------------------
# gemini | openai | demo. Gemini image models are billed-only: an unbilled key
# answers 429 with 'limit: 0', and the studio renderer takes over.
IMAGE_PROVIDER=demo
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Platform ---------------------------------------------------------------
# Only these addresses may open /ops. Everyone else gets a not-found.
PLATFORM_ADMIN_EMAILS=
ALLOW_DEV_LOGIN=false
AUTO_PROVISION_TENANT=false
ALLOW_DOMAIN_AUTO_JOIN=false
MAX_AGENT_REVISIONS=3

# --- Fleet pacing -----------------------------------------------------------
# Milliseconds between fleet steps. Raise it to make a live demo legible.
FLEET_STEP_DELAY_MS=700
FLEET_MAX_CONCURRENT_RUNS=4
