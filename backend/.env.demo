# The self-contained demo: the decision graph stays in this process.
#
# Loaded before .env, and dotenv never overwrites a value that is already set,
# so this wins over any DATABASE_URL in .env without editing or removing it.
# Everything else — the Anthropic key, the agent fleet, the image studio —
# still comes from .env and still runs live.
#
#   npm run dev:demo
#
# On Vercel there is nothing to do: .env is gitignored, so no DATABASE_URL is
# ever present and the same in-process store is used. Setting GRAPH_STORE=memory
# there as well makes it explicit rather than incidental.
GRAPH_STORE=memory
